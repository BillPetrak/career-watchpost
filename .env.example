# Career WatchPost reads the process environment; it does not load .env files.
# Replace placeholder paths and deliberately export selected variables in your
# shell, or supply them through your execution environment. Keep private state
# outside the checkout. Every example below is commented and inactive.
# Explicit CLI path options take precedence over these selectors.

# export CAREEROS_DATABASE=/absolute/private/path/careeros.sqlite3
# export CAREEROS_MATERIALS_ROOT=/absolute/private/path/materials
# Optional source configuration must already be an owned regular 0600 file.
# Selecting a missing explicit file is an error; leave unset for the XDG default.
# This example enables no provider and supplies no credentials.
# export CAREEROS_SOURCES_CONFIG=/absolute/private/path/sources.yaml

# XDG bases supply defaults when the corresponding selector above is unset.
# XDG_CONFIG_HOME also selects the default private Matching Profile location;
# there is no CAREEROS_PROFILE selector. A CLI profile path takes precedence.
# export XDG_DATA_HOME=/absolute/private/path/data
# export XDG_CONFIG_HOME=/absolute/private/path/config
